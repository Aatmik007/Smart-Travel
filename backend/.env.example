# JammuMove Backend Environment Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/jammumove
JWT_SECRET=your_jwt_secret_key_change_in_production
CORS_ORIGIN=http://localhost:5173

# Optional: Google Gemini API key for dynamic AI Route Assistant
# If empty or omitted, JammuMove gracefully falls back to the local deterministic Jammu transit knowledge engine.
GEMINI_API_KEY=
